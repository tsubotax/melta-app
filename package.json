{
  "name": "melta-app",
  "version": "0.1.0",
  "description": "melta for APP — React Native(Expo) 版 melta デザインシステム。@melta/contracts を single source of truth に RN 実装で満たす。",
  "main": "index.ts",
  "dependencies": {
    "expo": "~56.0.8",
    "expo-status-bar": "~56.0.4",
    "react": "19.2.3",
    "react-native": "0.85.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "@types/react": "~19.2.2",
    "eslint": "^10.4.1",
    "tsx": "^4.19.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.60.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "generate:theme": "tsx scripts/generate-native-theme.ts",
    "generate:contracts": "tsx scripts/generate-contract-types.ts",
    "generate": "npm run generate:theme && npm run generate:contracts",
    "test": "tsx --test scripts/lib/*.test.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p scripts/tsconfig.json",
    "lint": "eslint ."
  },
  "private": true
}
